# Deployment settings for docker compose.
#
# Copy to `.env` beside docker-compose.yml. Compose reads it automatically,
# and every value here used to be written into the committed files instead —
# which meant the database password and the server's address were in the
# repository.
#
# The backend and frontend keep their own .env files for application settings
# (Discord OAuth, JWT, locales). This one is only what compose itself needs.

# ── Database ───────────────────────────────────────────
# No default on purpose: compose refuses to start without it rather than
# falling back to a password that is written down in public.
#
# Note that Postgres only reads this when the data volume is first created.
# Changing it later does NOT change the password of an existing database —
# for that, run ALTER USER inside Postgres and then update this file.
POSTGRES_PASSWORD=

# ── Where this instance lives ──────────────────────────
# The host nginx answers for: a domain name, or a bare IP if that is what you
# have. Used for both server_name and the redirect to HTTPS.
SERVER_NAME=faction.example.com

# The name of the Let's Encrypt certificate directory under
# /etc/letsencrypt/live/. Usually identical to SERVER_NAME; set it separately
# when the certificate was issued under a different name.
CERT_NAME=faction.example.com

# What the browser calls the API. Baked into the frontend at build time, so
# changing it needs a rebuild, and it must be reachable from the player's
# machine rather than from inside the compose network.
NEXT_PUBLIC_API_URL=https://faction.example.com

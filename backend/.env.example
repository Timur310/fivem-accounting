# Discord OAuth 2.0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# ── Discord bot (optional) ─────────────────────────────
# Add a Bot to the SAME Discord application as the OAuth login above, then
# paste its token here. Leave blank to switch the Discord integration off —
# the app runs normally without it and says so on the settings screen.
DISCORD_BOT_TOKEN=
# Must be registered as a redirect URI on the Discord application as well.
DISCORD_BOT_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/bot-callback

# JWT
JWT_SECRET=
JWT_EXPIRATION_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/faction_accountant
POSTGRES_PASSWORD=password

# Server
PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

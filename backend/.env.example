# Discord OAuth 2.0
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/api/v1/auth/callback

# ── Discord bot (optional) ─────────────────────────────
# Add a Bot to the SAME Discord application as the OAuth login above, then
# paste its token here. Leave blank to switch the Discord integration off —
# the app runs normally without it and says so on the settings screen.
DISCORD_BOT_TOKEN=
# Must be registered as a redirect URI on the Discord application as well.
DISCORD_BOT_REDIRECT_URI=http://localhost:3000/api/v1/auth/discord/bot-callback

# The clock everything local runs on: quota periods, entry dates, and the time
# a Discord reminder fires. Most servers default to UTC, which makes a 20:00
# reminder arrive at 21:00 or 22:00 for players in Central Europe — wrong, but
# never reported as a fault. Set it to match the players.
TZ=Europe/Budapest

# JWT
JWT_SECRET=
JWT_EXPIRATION_DAYS=7

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/faction_accountant
POSTGRES_PASSWORD=password

# Backups (superadmin screen). pg_dump cannot run through a transaction-pooling
# pgbouncer, so this points straight at Postgres. Blank means use DATABASE_URL,
# which is right for a local setup with no pooler in front.
BACKUP_DATABASE_URL=
# Only needed where pg_dump/pg_restore are not on PATH — a Windows box with
# Postgres under "C:/Program Files/PostgreSQL/16/bin", for instance.
PG_BIN_DIR=
# Largest .dump the restore endpoint will accept. Keep nginx's
# client_max_body_size at or above this.
BACKUP_MAX_UPLOAD_MB=512

# Server
PORT=8000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
LOG_LEVEL=debug

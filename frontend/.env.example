# Backend API URL (no trailing slash)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Interface language the app starts in when the visitor has no saved choice
# and their browser asks for nothing the app speaks. One of: en, hu
NEXT_PUBLIC_DEFAULT_LOCALE=en

# Which languages the switcher offers, comma separated. Omit to offer all of
# them. The default locale above is always included.
# NEXT_PUBLIC_LOCALES=en,hu
